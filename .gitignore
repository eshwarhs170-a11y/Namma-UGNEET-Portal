# Exclude raw source documents
*.pdf
dataprocessing/AIQ-2025/*.txt
dataprocessing/2026/*.txt

.vercel
.env*

# Exclude large intermediate compiled JSON staging files (80-90 MB each).
# Regenerated locally by the compile scripts; only public/data/ JSONs are tracked.
dataprocessing/aiq_staging_output/*.json

# Exclude raw AIQ source text files (4-9 MB each, not needed in repo)
dataprocessing/aiq_source/**/*.txt

# Exclude all raw KEA/state counselling source text files (processed into public/data/ already)
dataprocessing/2024/*.txt
dataprocessing/2025/*.txt

# Exclude dataprocessing/output/ - duplicate of public/data/ (the real app data)
dataprocessing/output/

# Exclude any scratch/temp files in staging
dataprocessing/aiq_staging_output/*.txt
dataprocessing/scratch/

dataprocessing/node *
